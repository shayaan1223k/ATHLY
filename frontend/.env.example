# ATHLY Frontend Environment Configuration
# In local development with Vite dev proxy (vite.config.js), leave as /api
# In production on Vercel, set to your deployed Render backend API URL:
# VITE_API_BASE_URL=https://athly-backend.onrender.com/api
VITE_API_BASE_URL=/api

# Firebase Authentication Configuration
# Obtain these values from your Firebase Project Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
